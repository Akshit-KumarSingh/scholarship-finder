# Copy to .env and fill in the two required values. Never commit .env.

# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
LLM_API_KEY=<your-gemini-api-key>

# LLM: Gemini through its OpenAI-compatible endpoint (free tier)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
# To use OpenAI instead: remove LLM_BASE_URL, set LLM_API_KEY to your OpenAI key,
# and set LLM_MODEL to an OpenAI model name.

# Database
DB_NAME=scholarships

# Vector search: memory (default, no setup) or atlas (needs the vector index from SETUP.md)
VECTOR_BACKEND=memory
ATLAS_VECTOR_INDEX=vector_index

# Embeddings: local (384 numbers, free, runs on your machine) or openai (1536 numbers).
# After switching, re-run `npm run ingest`, and in Atlas set numDimensions to match.
EMBED_PROVIDER=local
# Only needed when EMBED_PROVIDER=openai (separate from LLM_API_KEY):
# OPENAI_API_KEY=<your-openai-api-key>

PORT=3000
